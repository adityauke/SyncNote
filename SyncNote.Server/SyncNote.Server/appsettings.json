{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Postgres": ""
  },

  "Jwt": {
    "Issuer": "SyncNote",
    "Audience": "SyncNote",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "SigningKey": ""
  },

  "Ai": {
    "Provider": "Gemini",
    "TimeoutSeconds": 120,
    "Providers": {
      "Gemini": {
        "ApiKey": "",
        "Model": "gemini-2.5-flash",
        "BaseUrl": "https://generativelanguage.googleapis.com"
      },
      "OpenAI": {
        "ApiKey": "",
        "Model": "gpt-4o-mini",
        "BaseUrl": "https://api.openai.com/v1"
      },
      "Ollama": {
        "ApiKey": "",
        "Model": "llama3.1",
        "BaseUrl": "http://localhost:11434"
      }
    }
  },

  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": true
  },

  "Persistence": {
    "AutosaveDebounceMilliseconds": 2000,
    "SnapshotEveryNChanges": 50,
    "MaxBufferedUpdateBytes": 1048576
  }
}
